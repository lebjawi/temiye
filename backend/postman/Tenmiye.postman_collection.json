                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titleAr\": \"إعلان هام\",\n  \"titleFr\": \"Annonce importante\",\n  \"contentAr\": \"محتوى الإعلان هنا...\",\n  \"contentFr\": \"Contenu de l'annonce ici...\",\n  \"authorNameAr\": \"أحمد محمد\",\n  \"category\": \"community\",\n  \"tags\": [\"مهم\", \"important\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/announcements",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPath}}", "announcements"]
            }
          }
        },
        {
          "name": "List Published Announcements",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/announcements?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPath}}", "announcements"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Get Announcement",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/announcements/{{announcementId}}",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPath}}", "announcements", "{{announcementId}}"]
