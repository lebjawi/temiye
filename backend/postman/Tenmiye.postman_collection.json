        },
        {
          "name": "Publish Announcement (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/announcements/{{announcementId}}/publish",
              "host": ["{{baseUrl}}"],
