          "name": "List Elections",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/elections",
              "host": ["{{baseUrl}}"],
