            "body": {
              "mode": "raw",
              "raw": "{\n  \"titleAr\": \"انتخاب رئيس المجلس\",\n  \"titleFr\": \"Election du président du conseil\",\n  \"descriptionAr\": \"انتخاب رئيس مجلس القرية\",\n  \"descriptionFr\": \"Election du président du conseil du village\",\n  \"type\": \"board_leader\",\n  \"candidateIds\": [\"user_candidate1\", \"user_candidate2\"],\n  \"startDate\": \"2025-02-01T00:00:00Z\",\n  \"endDate\": \"2025-02-07T23:59:59Z\",\n  \"requiresQuorum\": true,\n  \"quorumPercentage\": 50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}{{apiPath}}/elections",
              "host": ["{{baseUrl}}"],
              "path": ["{{apiPath}}", "elections"]
            }
          }
        },
