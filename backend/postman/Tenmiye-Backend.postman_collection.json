					}
				}
			]
		},
		{
			"name": "Constants",
			"item": [
				{
					"name": "Get All Constants",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Save commonly used values",
									"if (pm.response.code === 200) {",
									"    const data = pm.response.json().data;",
									"    pm.environment.set('min_contribution', data.minContribution);",
									"    pm.environment.set('max_contribution', data.maxContribution);",
									"    pm.environment.set('voting_duration_days', data.votingDurationDays);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/constants",
							"host": ["{{base_url}}"],
							"path": ["api", "constants"]
						},
						"description": "Get all system configuration constants (cached 5 minutes)"
					}
				},
				{
					"name": "Get Min Contribution",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/constants/min-contribution",
							"host": ["{{base_url}}"],
							"path": ["api", "constants", "min-contribution"]
						}
					}
				},
				{
