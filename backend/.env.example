# Server Configuration
PORT=3000
NODE_ENV=development

# Firebase Configuration
# Option 1: Use Application Default Credentials (recommended for local development with gcloud SDK)
# No env vars needed - Firebase Admin SDK will auto-detect

# Option 2: Use Service Account Key file
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option 3: Use Service Account Key JSON string
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY_DAYS=7

# Twilio Configuration (for SMS/WhatsApp password reset)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000

# Pagination Defaults (can be overridden by Constants domain)
DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100
