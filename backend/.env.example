# Node Environment
NODE_ENV=development
PORT=8080

# Firebase Configuration
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# JWT Configuration
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY_HOURS=24

# Security Settings
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
# For development, use http://localhost:4200
# For production, add your domain: https://tenmiye.mr
# Multiple origins: http://localhost:4200,https://tenmiye.mr
ALLOWED_ORIGINS=http://localhost:4200

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE_ENABLED=true
LOG_CONSOLE_ENABLED=true

# Optional: SMS Provider (for future implementation)
# SMS_PROVIDER=twilio|africa_talking|masrvi
# SMS_API_KEY=
# SMS_API_SECRET=

# Optional: Email Service (for future implementation)
# EMAIL_PROVIDER=sendgrid|mailgun
# EMAIL_API_KEY=
# EMAIL_FROM=noreply@tenmiye.mr
